{
  // The app's compiler options, applied to the test files tsconfig.app.json leaves out
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    // vitest.config.ts sets globals: true; src/test/setup.ts loads the jest-dom matchers
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom/vitest"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test/**/*",
    "src/integration/**/*",
    "src/**/*.d.ts"
  ],
  // Replaces the inherited exclude, which is what keeps tests out of the app project
  "exclude": []
}
