{
  "name": "doskit",
  "version": "1.0.1",
  "description": "A robust, cross-platform foundation for running DOS applications using js-dos WebAssembly technology",
  "type": "module",
  "author": "Cameron Rye <cameron@rye.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cameronrye/doskit.git"
  },
  "bugs": {
    "url": "https://github.com/cameronrye/doskit/issues"
  },
  "homepage": "https://github.com/cameronrye/doskit#readme",
  "keywords": [
    "dos",
    "emulator",
    "dosbox",
    "webassembly",
    "wasm",
    "js-dos",
    "retro",
    "gaming",
    "cross-platform",
    "react",
    "typescript"
  ],
  "scripts": {
    "help": "node scripts/help.js",
    "dev": "vite",
    "build": "node scripts/generate-social-images.js && tsc -b && vite build && node scripts/inject-sw-version.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "generate-icons": "node scripts/generate-icons.js",
    "generate-social-images": "node scripts/generate-social-images.js",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "vitest related --run"
    ],
    "*.{ts,tsx,css,md,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "js-dos": "8.3.20",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "4.0.10",
    "@vitest/ui": "4.0.10",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jsdom": "27.2.0",
    "lint-staged": "16.2.6",
    "picocolors": "1.1.1",
    "prettier": "3.6.2",
    "sharp": "0.34.5",
    "typedoc": "0.28.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "npm:rolldown-vite@7.1.14",
    "vitest": "4.0.10"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14"
  },
  "comments": {
    "vite": "Using experimental Rolldown variant for improved build performance. For production, consider switching to stable Vite: 'vite': '^7.1.14'"
  }
}
